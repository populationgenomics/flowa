{
  "name": "@flowajs/chat-service",
  "version": "0.4.0",
  "description": "Stateless service that orchestrates LLM conversations over flowa artifacts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/populationgenomics/flowa.git",
    "directory": "packages/chat-service"
  },
  "homepage": "https://github.com/populationgenomics/flowa#readme",
  "bugs": {
    "url": "https://github.com/populationgenomics/flowa/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./auth/oidc": "./dist/auth/oidc.js",
    "./storage": "./dist/storage/factory.js",
    "./storage/fs": "./dist/storage/fs.js",
    "./storage/s3": "./dist/storage/s3.js",
    "./storage/gcs": "./dist/storage/gcs.js",
    "./storage/interface": "./dist/storage/interface.js",
    "./llm": "./dist/llm/factory.js",
    "./llm/interface": "./dist/llm/interface.js",
    "./llm/anthropic": "./dist/llm/anthropic.js",
    "./llm/bedrock": "./dist/llm/bedrock.js",
    "./llm/google": "./dist/llm/google.js",
    "./llm/google-cloud": "./dist/llm/google-cloud.js",
    "./llm/openai": "./dist/llm/openai.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentation.js dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/otel": "1.0.97",
    "@hono/node-server": "2.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.77.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "ai": "7.0.97",
    "aws4fetch": "1.0.20",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "nunjucks": "3.2.4",
    "yaml": "2.9.0",
    "zod": "4.6.1"
  },
  "peerDependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.0",
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/google-vertex": "^5.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/credential-providers": "^3.0.0",
    "@google-cloud/storage": "^7.0.0"
  },
