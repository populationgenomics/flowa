    "@ai-sdk/amazon-bedrock": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/google-vertex": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/credential-providers": {
      "optional": true
    },
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.81",
    "@ai-sdk/anthropic": "4.0.54",
    "@ai-sdk/google": "4.0.67",
    "@ai-sdk/google-vertex": "5.0.79",
    "@ai-sdk/openai": "4.0.65",
    "@aws-sdk/client-s3": "3.1129.0",
    "@aws-sdk/credential-providers": "3.1129.0",
    "@google-cloud/storage": "7.21.0",
    "@types/node": "26.5.1",
    "@types/nunjucks": "3.2.6",
    "typescript": "5.7.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
